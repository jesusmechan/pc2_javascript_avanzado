# Copia este archivo como .env y cambia los valores. El archivo .env no se sube al repositorio.
PORT=3001
CORS_ORIGINS=http://localhost:4200
# Clave para firmar los tokens de sesión. Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=reemplaza-esta-clave-por-una-aleatoria
TOKEN_DURACION_HORAS=168
